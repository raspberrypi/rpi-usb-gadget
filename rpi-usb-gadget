#!/bin/sh

# ----- root + platform checks -----
if [ "$(id -u)" -ne 0 ]; then
    printf '\033[31mPlease run this script as root\033[0m\n' >&2
    exit 1
fi

if ! [ -r /proc/device-tree/model ] || ! grep -q 'Raspberry Pi' /proc/device-tree/model; then
    printf '\033[31mThis script is for Raspberry Pi devices only\033[0m\n' >&2
    exit 1
fi

# ----- Settings -----
NM_IFACE="${USB_GADGET_IFACE:-usb0}"

CLIENT_NAME='USB Gadget (client)'
SHARED_NAME='USB Gadget (shared)'
SERVICE="rpi-usb-gadget-ics.service"
GADGET_SERVICE="rpi-usb-gadget.service"

# Composite gadget: one function per host family, each with its own netdev.
# NM_IFACE is a bridge over both, so the Pi keeps a single interface.
GADGET_DIR=/sys/kernel/config/usb_gadget/rpi-usb-gadget
RNDIS_PORT=usbrndis0
ECM_PORT=usbecm0
RNDIS_PORT_NAME='USB Gadget (RNDIS port)'
ECM_PORT_NAME='USB Gadget (ECM port)'
UDC_WAIT=10

SHARED_ADDR="10.12.194.1/28"
CLIENT_DHCP_TIMEOUT=6
CLIENT_ROUTE_METRIC=100
NM_WAIT_DOWN=5
NM_WAIT_UP=10

# modules-load + overlay
MODS_CONF="/etc/modules-load.d/usb-gadget.conf"
CFG_FW=/boot/firmware/config.txt
CFG_LEGACY=/boot/config.txt
OVERLAY_LINE='dtoverlay=dwc2,dr_mode=peripheral'
DNSMASQ_DIR=/etc/NetworkManager/dnsmasq-shared.d
DNSMASQ_SNIPPET="$DNSMASQ_DIR/90-rpi-usb-gadget-lease.conf"

# A list of supported devices (for informational purposes)
SUPPORTED_DEVICES="$(printf '%s\n' 'Raspberry Pi Zero' 'Raspberry Pi Zero W' 'Raspberry Pi Zero 2 W' 'Raspberry Pi 3 Model A+' 'Raspberry Pi 4 Model B' 'Raspberry Pi 5 Model B' 'Raspberry Pi 500' 'Raspberry Pi Compute Module 0' 'Raspberry Pi Compute Module 5')"

#################################
##### Systemd service setup #####
#################################

have_systemctl() { command -v systemctl >/dev/null 2>&1; }

# /sys/class/udc is populated when a UDC driver (dwc2 in peripheral mode) is active
overlay_active() { set -- /sys/class/udc/*; [ -e "$1" ]; }

cfg_has_overlay() {
    grep -q "^${OVERLAY_LINE}\$" "$CFG_FW" 2>/dev/null || \
    grep -q "^${OVERLAY_LINE}\$" "$CFG_LEGACY" 2>/dev/null
}

# Append the dwc2 overlay line so that it actually takes effect.
# A bare append is wrong in two ways: if config.txt has no trailing
# newline the line is glued onto the previous one (e.g. onto a
# "#dtoverlay=disable-wifi" comment) and never parsed; and if the file
# currently ends inside a model filter such as [cm5] or [pi5] the line is
# scoped to that model and is inert on every other board. Both leave the
# controller in host/otg mode with no error anywhere. Terminate the last
# line and open an [all] section first unless one is already open.
cfg_append_overlay() {
    f="$1"
    [ -w "$f" ] || return 1
    if [ -s "$f" ] && [ -n "$(tail -c1 "$f")" ]; then
        printf '\n' >> "$f"
    fi
    last_filter="$(grep -E '^[[:space:]]*\[[^]]*\]' "$f" | tail -n 1 | tr -d '[:space:]')"
    if [ "$last_filter" != "[all]" ]; then
        printf '\n[all]\n' >> "$f"
    fi
    printf '%s\n' "$OVERLAY_LINE" >> "$f"
}

svc_enable_now() {
    have_systemctl || return 0
    systemctl daemon-reload || true
    systemctl enable --now "$SERVICE" 2>/dev/null || true
}

svc_disable_now() {
    have_systemctl || return 0
    systemctl disable --now "$SERVICE" 2>/dev/null || true
}

##########################
##### Gadget (configfs) ##
##########################

first_udc() { set -- /sys/class/udc/*; [ -e "$1" ] && basename "$1"; }

gadget_down() {
    g="$GADGET_DIR"
    [ -d "$g" ] || return 0
    printf '\n' > "$g/UDC" 2>/dev/null || true
    rm -f "$g/os_desc/c.1" "$g/configs/c.1/rndis.usb0" "$g/configs/c.2/ecm.usb0"
    rmdir "$g/configs/c.1/strings/0x409" "$g/configs/c.2/strings/0x409" \
          "$g/configs/c.1" "$g/configs/c.2" \
          "$g/functions/rndis.usb0" "$g/functions/ecm.usb0" \
          "$g/strings/0x409" "$g" 2>/dev/null || true
}

gadget_up() {
    g="$GADGET_DIR"

    # A g_ether left over from an older package version holds the UDC
    modprobe -r g_ether 2>/dev/null || true
    modprobe libcomposite 2>/dev/null || true
    [ -d /sys/kernel/config/usb_gadget ] || \
        mount -t configfs none /sys/kernel/config 2>/dev/null || true

    # dwc2 may still be probing this early in boot
    n=0
    until udc=$(first_udc); do
        n=$((n + 1))
        if [ "$n" -gt "$UDC_WAIT" ]; then
            printf 'No USB device controller found; is the dwc2 overlay active?\n' >&2
            return 1
        fi
        sleep 1
    done

    gadget_down
    mkdir -p "$g/strings/0x409" "$g/functions/rndis.usb0" "$g/functions/ecm.usb0" \
             "$g/configs/c.1/strings/0x409" "$g/configs/c.2/strings/0x409" || return 1

    serial=$(awk '/^Serial/{print $3; exit}' /proc/cpuinfo)

    # bcdDevice is 0x0200 because Windows caches "no OS descriptors" per
    # VID/PID/revision, and g_ether shipped as 0x0100.
    printf '0x2E8A\n' > "$g/idVendor"
    printf '0x0013\n' > "$g/idProduct"
    printf '0x0200\n' > "$g/bcdDevice"
    printf '0x0200\n' > "$g/bcdUSB"
    printf '0xEF\n'   > "$g/bDeviceClass"
    printf '0x02\n'   > "$g/bDeviceSubClass"
    printf '0x01\n'   > "$g/bDeviceProtocol"
    printf 'Raspberry Pi Ltd.\n'       > "$g/strings/0x409/manufacturer"
    printf 'Raspberry Pi USB Gadget\n' > "$g/strings/0x409/product"
    printf '%s\n' "$serial"            > "$g/strings/0x409/serialnumber"

    printf 'usbrndis%%d\n' > "$g/functions/rndis.usb0/ifname"
    printf 'usbecm%%d\n'   > "$g/functions/ecm.usb0/ifname"

    # Microsoft OS descriptors: Windows binds its in-box RNDIS 6 driver
    # with no INF. The RNDIS interface class is left alone on purpose;
    # Linux hosts skip a leading RNDIS configuration only for that class.
    printf '1\n'       > "$g/os_desc/use"
    printf '0xcd\n'    > "$g/os_desc/b_vendor_code"
    printf 'MSFT100\n' > "$g/os_desc/qw_sign"
    printf 'RNDIS\n'   > "$g/functions/rndis.usb0/os_desc/interface.rndis/compatible_id"
    printf '5162001\n' > "$g/functions/rndis.usb0/os_desc/interface.rndis/sub_compatible_id"

    # Same layout as g_ether: Windows takes configuration 1, Linux and
    # macOS take configuration 2.
    printf 'RNDIS\n'   > "$g/configs/c.1/strings/0x409/configuration"
    printf 'CDC ECM\n' > "$g/configs/c.2/strings/0x409/configuration"
    ln -s "$g/functions/rndis.usb0" "$g/configs/c.1/" || return 1
    ln -s "$g/functions/ecm.usb0"   "$g/configs/c.2/" || return 1
    ln -s "$g/configs/c.1" "$g/os_desc/" || return 1

    if ! printf '%s\n' "$udc" > "$g/UDC"; then
        printf 'Could not bind the gadget to %s\n' "$udc" >&2
        return 1
    fi
}

gadget_svc_enable() {
    have_systemctl || return 0
    systemctl daemon-reload || true
    systemctl enable "$GADGET_SERVICE" 2>/dev/null || true
}

gadget_svc_disable_now() {
    have_systemctl || { gadget_down; return 0; }
    systemctl disable --now "$GADGET_SERVICE" 2>/dev/null || true
}

svc_status() {
    have_systemctl || { printf '(no systemd)\n'; return; }
    if systemctl --quiet is-enabled "$SERVICE"; then en=yes; else en=no; fi
    if systemctl --quiet is-active  "$SERVICE"; then ac=yes; else ac=no; fi
    printf "ICS watcher: enabled=$en active=$ac\n"
}

################################
# NetworkManager (nmcli) setup #
################################

have_nmcli() { command -v nmcli >/dev/null 2>&1; }

nm_down() { nmcli -w "$NM_WAIT_DOWN" con down "$1" >/dev/null 2>&1 || true; }
nm_up()   { nmcli -w "$NM_WAIT_UP"   con up   "$1" >/dev/null 2>&1 || true; }

# Return the first UUID whose connection.id == $1
nm_first_uuid_by_name() {
    nmcli -t -f NAME,UUID connection show 2>/dev/null \
      | awk -F: -v n="$1" '$1==n { print $2; exit }'
}

# Delete ALL connections with connection.id == $1
nm_delete_all_by_name() {
    nmcli -t -f NAME,UUID connection show 2>/dev/null \
      | awk -F: -v n="$1" '$1==n { print $2 }' \
      | while IFS= read -r u; do
            [ -n "$u" ] && nmcli connection delete uuid "$u" >/dev/null 2>&1 || true
        done
}

# Ensure exactly one profile named $1 of type $2 on interface $3; the
# remaining arguments are nmcli settings.
nm_ensure_profile() {
    p_name="$1"; p_type="$2"; p_iface="$3"; shift 3
    case "$p_type" in
        ethernet) p_nmtype=802-3-ethernet ;;
        *)        p_nmtype="$p_type" ;;
    esac

    uuid=$(nm_first_uuid_by_name "$p_name")

    # A profile's type cannot be modified: replace those made for g_ether
    if [ -n "$uuid" ] && \
       [ "$(nmcli -g connection.type connection show uuid "$uuid" 2>/dev/null)" != "$p_nmtype" ]; then
        nm_delete_all_by_name "$p_name"
        uuid=""
    fi

    if [ -z "$uuid" ]; then
        nm_delete_all_by_name "$p_name"  # paranoia cleanup
        nmcli connection add type "$p_type" ifname "$p_iface" con-name "$p_name" \
            "$@" >/dev/null 2>&1 || true
    else
        # modify by UUID so we don't hit the "multiple connections with same name" warning
        nmcli connection modify uuid "$uuid" \
            connection.interface-name "$p_iface" \
            "$@" >/dev/null 2>&1 || true

        # remove any other duplicates that might exist
        nmcli -t -f NAME,UUID connection show 2>/dev/null \
          | awk -F: -v n="$p_name" '$1==n { print $2 }' \
          | tail -n +2 | while IFS= read -r du; do
                [ -n "$du" ] && nmcli connection delete uuid "$du" >/dev/null 2>&1 || true
            done
    fi
}

nm_ensure_client() {
    # DHCP client (for ICS); IPv6 disabled; short timeout; prefer routes via DHCP
    nm_ensure_profile "$CLIENT_NAME" bridge "$NM_IFACE" \
        connection.autoconnect no \
        connection.autoconnect-priority 100 \
        connection.autoconnect-slaves 1 \
        bridge.stp no \
        ipv4.method auto \
        ipv4.may-fail yes \
        ipv4.route-metric "$CLIENT_ROUTE_METRIC" \
        ipv4.dhcp-timeout "$CLIENT_DHCP_TIMEOUT" \
        ipv6.method link-local
}

nm_ensure_shared() {
    # Pi serves DHCP+NAT on 10.12.194.0/28; IPv6 disabled; do autoconnect
    nm_ensure_profile "$SHARED_NAME" bridge "$NM_IFACE" \
        connection.autoconnect yes \
        connection.autoconnect-priority 10 \
        connection.autoconnect-slaves 1 \
        bridge.stp no \
        ipv4.method shared \
        ipv4.addresses "$SHARED_ADDR" \
        ipv6.method link-local
}

nm_ensure_ports() {
    for p in "$RNDIS_PORT:$RNDIS_PORT_NAME" "$ECM_PORT:$ECM_PORT_NAME"; do
        nm_ensure_profile "${p#*:}" ethernet "${p%%:*}" \
            connection.autoconnect yes \
            connection.master "$NM_IFACE" \
            connection.slave-type bridge
        # udev marks gadget netdevs unmanaged; the conf.d drop-in only
        # covers devices that appear after NetworkManager read it
        nmcli device set "${p%%:*}" managed yes >/dev/null 2>&1 || true
    done
}

# True once the profiles are the bridge kind (false after an upgrade
# from the g_ether layout, or before the first "on")
nm_profiles_current() {
    uuid=$(nm_first_uuid_by_name "$SHARED_NAME")
    [ -n "$uuid" ] || return 1
    [ "$(nmcli -g connection.type connection show uuid "$uuid" 2>/dev/null)" = bridge ] || return 1
    [ -n "$(nm_first_uuid_by_name "$RNDIS_PORT_NAME")" ] && \
    [ -n "$(nm_first_uuid_by_name "$ECM_PORT_NAME")" ]
}

nm_setup() {
    nm_dnsmasq_setup
    nm_ensure_client
    nm_ensure_shared
    nm_ensure_ports
    nmcli connection reload >/dev/null 2>&1 || true
}

nm_remove_profiles() {
    nm_delete_all_by_name "$CLIENT_NAME"
    nm_delete_all_by_name "$SHARED_NAME"
    nm_delete_all_by_name "$RNDIS_PORT_NAME"
    nm_delete_all_by_name "$ECM_PORT_NAME"
    nmcli connection reload >/dev/null 2>&1 || true
}

nm_dnsmasq_setup() {
    mkdir -p "$DNSMASQ_DIR" && chmod 0755 "$DNSMASQ_DIR"
    : "${DNSMASQ_SNIPPET:=$DNSMASQ_DIR/90-rpi-usb-gadget-lease.conf}"

    cat >"$DNSMASQ_SNIPPET" <<'EOF'
# Autogenerated by rpi-usb-gadget – safe to delete

# controls server behaviour (send NAKs immediately, faster failover)
dhcp-authoritative
# 2 minute leases (clients should renew every 1 minute)
dhcp-option=51,120
# suppresses dnsmasq’s DHCP chatter in logs
quiet-dhcp
EOF

    # If shared is currently active, bounce it so the new dnsmasq picks this up
    if nmcli -t -f NAME con show --active | grep -F -q -e "^$SHARED_NAME$"; then
        nm_down "$SHARED_NAME"
        nm_up   "$SHARED_NAME"
    fi
}

nm_dnsmasq_remove() {
    rm -f "$DNSMASQ_SNIPPET" || true
    
    # Bounce only if the shared profile is active
    if nmcli -t -f NAME con show --active | grep -F -q -e "^$SHARED_NAME$"; then
        nm_down "$SHARED_NAME"
        nm_up   "$SHARED_NAME"
    fi
}

nm_status() {
  printf ':: NetworkManager:\n'
  if ! have_nmcli; then
    printf '  (nmcli not found)\n'; return
  fi

  # Pull details for the gadget iface
  st=""
  fullst=$(nmcli -g GENERAL.STATE device show "$NM_IFACE" 2>/dev/null)
  st=$(printf '%s' "$fullst" | sed -n 's/.*(\(.*\)).*/\1/p')   # extract text in ()
  [ -n "$st" ] || st="$fullst"
  active=$(nmcli -g GENERAL.CONNECTION device show "$NM_IFACE" 2>/dev/null)
  ip4=$(nmcli -g IP4.ADDRESS device show "$NM_IFACE" 2>/dev/null | head -n1)
  gw=$(nmcli -g IP4.GATEWAY device show "$NM_IFACE" 2>/dev/null)

  host=none
  [ "$(cat "/sys/class/net/$RNDIS_PORT/carrier" 2>/dev/null)" = 1 ] && host='RNDIS (Windows)'
  [ "$(cat "/sys/class/net/$ECM_PORT/carrier" 2>/dev/null)" = 1 ] && host='CDC-ECM (Linux/macOS)'

  printf "  iface:        %s\n" "$NM_IFACE"
  printf "  host link:    %s\n" "$host"
  printf "  link:         %s\n" "${st:--}"
  printf "  active prof:  %s\n" "${active:--}"
  printf "  IPv4:         %s\n" "${ip4:--}"
  printf "  gateway:      %s\n" "${gw:--}"

  # List our two profiles with autoconnect + priority
  LC_ALL=C nmcli -t -f NAME,AUTOCONNECT,AUTOCONNECT-PRIORITY connection show \
    | awk -F: -v c1="$CLIENT_NAME" -v c2="$SHARED_NAME" '
    BEGIN { IGNORECASE=1 }
    $1==c1 || $1==c2 {
        v = tolower($2)
        prio = ($3 == "" ? 0 : $3)
        mode = (v=="yes" || v=="on" || v=="true" || v=="1") ? "auto" : "manual"
        printf "  profile:      %s [%s, prio %s]\n", $1, mode, prio
    }'
}

#################################
# Main script logic starts here #
#################################

TURN_ON=true
FORCE=false
case "$1" in
    on)      TURN_ON=true ;;
    off)     TURN_ON=false ;;
    toggle)
        if [ -f "$MODS_CONF" ]; then
            TURN_ON=false
        fi
        ;;
    start)
        # Boot-time entry point for rpi-usb-gadget.service
        gadget_up || exit 1
        if have_nmcli && ! nm_profiles_current; then
            nm_setup
            nm_up "$SHARED_NAME"
        fi
        exit 0
        ;;
    stop)
        gadget_down
        exit 0
        ;;
    status)
        if [ -f "$MODS_CONF" ]; then
            printf '\033[33mUSB Gadget mode is on\033[0m\n'
        else
            printf '\033[33mUSB Gadget mode is off\033[0m\n'
        fi
        nm_status
        svc_status
        exit 0
        ;;
    help|"")
        printf "Usage: rpi-usb-gadget [on|off|toggle|status|help]\n"
        exit 1
        ;;
    *)
        printf "Usage: rpi-usb-gadget [on|off|toggle|status|help]\n"
        exit 1
        ;;
esac

if [ "$2" = "-f" ] || [ "$2" = "--force" ]; then
    FORCE=true
fi

check_supported() {
    # Read and sanitize the model string
    model=$(tr -d '\0' < /proc/device-tree/model | tr -d '\r')
    
    # Strip "Rev ..." and trailing spaces
    base_model=$(printf '%s' "$model" \
        | sed -E 's/[[:space:]]+Rev[[:space:]].*$//' \
        | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')

    # Check if the cleaned base model is exactly in the list or matches a prefix
    if printf '%s\n' "$SUPPORTED_DEVICES" | grep -Fxq "$base_model"; then
        return 0
    fi

    printf '\033[33mWarning: Your device model is not in the list of supported devices:\033[0m\n'
    printf '%s\n' "$SUPPORTED_DEVICES" | sed 's/^/  - /'
    printf '\033[33mYour device model (raw): %s\033[0m\n' "$model"
    printf '\033[33mDetected model (cleaned): %s\033[0m\n' "$base_model"

    if [ "$FORCE" = false ]; then
        while true; do
            printf 'Do you want to continue? (y/n): '
            read -r ans
            case "$ans" in
                y|Y) return 0 ;;
                n|N) return 1 ;;
                *)   printf 'Please answer y or n.\n' ;;
            esac
        done
    else
        printf '\033[33mForce flag detected; proceeding despite unsupported device.\033[0m\n'
        return 0
    fi
}

NEED_REBOOT=false

if [ "$TURN_ON" = false ]; then
    printf 'Turning \033[31moff\033[0m USB Gadget mode\n'

    # stop ICS watcher first
    svc_disable_now

    # stop NM bits first
    if have_nmcli; then
        nm_down "$SHARED_NAME"
        nm_down "$CLIENT_NAME"
        nm_remove_profiles
        nm_dnsmasq_remove
    fi

    # kernel gadget off
    gadget_svc_disable_now
    rm -f "$MODS_CONF"
    sed -i "\|^$OVERLAY_LINE\$|d" "$CFG_FW" 2>/dev/null || true
    sed -i "\|^$OVERLAY_LINE\$|d" "$CFG_LEGACY" 2>/dev/null || true
    # UDC stays bound until reboot
    if overlay_active; then
        NEED_REBOOT=true
    fi

else
    check_supported || exit 1

    printf 'Turning \033[32mon\033[0m USB Gadget mode\n'
    printf "libcomposite\n" > "$MODS_CONF"
    if ! cfg_has_overlay; then
        # ensure overlay present once, under an [all] filter
        sed -i "\|^$OVERLAY_LINE\$|d" "$CFG_FW" 2>/dev/null || true
        sed -i "\|^$OVERLAY_LINE\$|d" "$CFG_LEGACY" 2>/dev/null || true
        cfg_append_overlay "$CFG_FW" 2>/dev/null || cfg_append_overlay "$CFG_LEGACY"
    fi
    gadget_svc_enable
    # config.txt may already carry the overlay from a run that was never rebooted
    if overlay_active; then
        if have_systemctl; then
            systemctl restart "$GADGET_SERVICE" 2>/dev/null || true
        else
            gadget_up || true
        fi
    else
        NEED_REBOOT=true
    fi

    # NetworkManager: dnsmasq + bridge profiles (client, shared) + ports
    if have_nmcli; then
        nm_setup

        # Try client first; ICS-watch will flip to shared if no DHCP/gateway
        nm_down "$CLIENT_NAME"
        nm_up   "$SHARED_NAME"

        # start ICS watcher so it can auto-switch client/shared
        svc_enable_now
    else
        printf '\033[33mNetworkManager (nmcli) not found; skipping NM auto-config.\033[0m\n'
    fi
fi

if [ "$NEED_REBOOT" = true ]; then
    printf "Reboot to apply changes\n"
fi
