#!/bin/sh
# Show a Windows hint only while the USB gadget is enabled.
# Enabled = /etc/modules-load.d/usb-gadget.conf exists.

CONF_FILE=/etc/modules-load.d/usb-gadget.conf

if [ -f "$CONF_FILE" ]; then
    echo
    echo "USB Gadget hint"
    echo "Windows 10 and 11 pick up USB Ethernet automatically. If no adapter appears:"
    echo "→ https://github.com/raspberrypi/rpi-usb-gadget?tab=readme-ov-file#windows-setup--troubleshooting-ics--rndis"
    echo
    echo "(This message appears because rpi-usb-gadget is enabled.)"
    echo
fi
