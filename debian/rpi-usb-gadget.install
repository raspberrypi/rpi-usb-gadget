# NetworkManager: manage the gadget netdevs
90-rpi-usb-gadget.conf                  usr/lib/NetworkManager/conf.d/

# helper scripts/binaries
rpi-usb-gadget                          usr/bin/
ics-watch                               usr/libexec/rpi-usb-gadget/

# Motd hook
99-rpi-usb-gadget                       etc/update-motd.d/

# Systemd service
rpi-usb-gadget.service                  usr/lib/systemd/system/
rpi-usb-gadget-ics.service              usr/lib/systemd/system/
